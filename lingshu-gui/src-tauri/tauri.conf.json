{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "灵枢",
  "mainBinaryName": "灵枢",
  "version": "1.0.0",
  "identifier": "com.administrator.lingshu-gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run stage:desktop:build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "灵枢 AI",
        "width": 1366,
        "height": 768,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/backend/": "backend/"
    },
    "icon": [
      "../public/app.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
